# Copia este archivo a .env y llena los valores. Nunca subas .env al repo.

# Modelos (OpenRouter)
OPENROUTER_API_KEY=
# Operador: decide cada paso (muchas llamadas por tarea, por eso el barato)
AGENT_MODEL=anthropic/claude-haiku-5.5
# Supervisor: comprensión, revisión pre-guardado, verificación y escalamiento (pocas llamadas)
SUPERVISOR_MODEL=anthropic/claude-sonnet-5.5

# Token del equipo: lo exige nuestro entrypoint en Authorization: Bearer
TEAM_TOKEN=

# Escritorio de pruebas (solo para el harness local; en evaluación llega en POST /tasks)
DESKTOP_URL=wss://frontier-r1-tm53-production.up.railway.app/websockify
DESKTOP_PASSWORD=
# Token del escritorio para /__reset y /__check
DESKTOP_TOKEN=
