flowchart LR
  G([Evaluador]) -->|"POST /tasks<br/>tarea + escritorio"| API
  API -->|"GET /tasks/{id}<br/>estado + resumen"| G

  subgraph SVC["Servicio del agente · FastAPI en Railway, siempre encendido"]
    API["Entrypoint<br/>token Bearer<br/>task_id en menos de 2 s"]
    STORE[("Registro de tareas")]
    API <--> STORE

    subgraph RUN["Ejecutor de tareas · una tarea asyncio por petición"]
      PLAN["Planificador · Sonnet 5.5<br/>objetivo, entidades, riesgos:<br/>¿ambigua, imposible,<br/>peligrosa?"]
      EXEC["Ejecutor · Haiku 5.5<br/>lee la pantalla y<br/>propone UNA acción"]
      VER["Verificador · código<br/>¿cambió la pantalla?<br/>límite 4:30, pasos, tope de costo,<br/>detector de atasco"]
      ESC["Escalamiento · Sonnet 5.5<br/>tras 2 acciones sin efecto"]
      JUDGE["Juez · Sonnet 5.5<br/>pantalla final + registro:<br/>terminada o fallida"]
      FMT["Formateador · código<br/>línea respuesta,<br/>borra secretos"]
      PLAN --> EXEC
      EXEC -->|acción| VER
      VER -->|siguiente paso| EXEC
      VER -->|sin efecto x2| ESC
      ESC --> VER
      VER -->|terminó o límite| JUDGE
      JUDGE --> FMT
    end
    API -->|lanza| PLAN
    FMT --> STORE
  end

  VER <-->|"salen acciones (clic sostenido 150 ms,<br/>seleccionar todo antes de escribir)<br/>entran capturas estables"| VNC["Cliente VNC · código<br/>RFB sobre websocket"]
  VNC <==> DESK[("Escritorio remoto<br/>navegador en kiosko +<br/>app heredada, 1280x800")]
  RUN -.-> LOG[("Registro con hora<br/>captura por paso,<br/>costo por llamada")]

  classDef model fill:#fde8d0,stroke:#d9822b,color:#222;
  classDef code fill:#dcebfa,stroke:#3b7dd8,color:#222;
  classDef ext fill:#eeeeee,stroke:#888,color:#222;
  class PLAN,EXEC,ESC,JUDGE model;
  class API,VER,FMT,VNC,STORE,LOG code;
  class G,DESK ext;
